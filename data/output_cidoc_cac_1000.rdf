  <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/P137_exemplifies">
    <rdfs:label xml:lang="en">exemplifies</rdfs:label>
    <rdfs:label xml:lang="el">δειγματίζει</rdfs:label>
    <rdfs:label xml:lang="fr">exemplifie</rdfs:label>
    <rdfs:label xml:lang="pt">é exemplificado por</rdfs:label>
    <rdfs:label xml:lang="ru">иллюстрируeт</rdfs:label>
    <rdfs:label xml:lang="zh">例示</rdfs:label>
    <rdfs:label xml:lang="de">erläutert</rdfs:label>
    <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
    <rdfs:comment xml:lang="en">This property associates an instance of E1 CRM Entity with an instance of E55 Type for which it has been declared to be a particularly characteristic example.
The P137.1 in the taxonomic role property of P137 exemplifies (is exemplified by) allows differentiation of taxonomic roles. The taxonomic role renders the specific relationship of this example to the type, such as "prototypical", "archetypical", "lectotype", etc. The taxonomic role "lectotype" is not associated with the instance of E83 Type Creation itself but is selected in a later phase.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
    <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity"/>
    <owl:inverseOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P137i_is_exemplified_by"/>
  </rdf:Description>
