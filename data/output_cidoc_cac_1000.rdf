  <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span">
    <rdfs:label xml:lang="de">hat Zeitspanne</rdfs:label>
    <rdfs:label xml:lang="el">βρισκόταν σε εξέλιξη</rdfs:label>
    <rdfs:label xml:lang="fr">a pour intervalle temporel</rdfs:label>
    <rdfs:label xml:lang="zh">发生时段是</rdfs:label>
    <rdfs:label xml:lang="pt">tem período de tempo</rdfs:label>
    <rdfs:label xml:lang="en">has time-span</rdfs:label>
    <rdfs:label xml:lang="ru">имeeт врeмeнной интeрвал</rdfs:label>
    <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E2_Temporal_Entity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">This property associates an instance of E2 Temporal Entity with the instance of E52 Time-Span during which it was on-going. The associated instance of E52 Time-Span is understood as the real time-span during which the phenomena making up the temporal entity instance were active. More than one instance of E2 Temporal Entity may share a common instance of E52 Time-Span only if they come into being and end being due to identical declarations or events.</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P4i_is_time-span_of"/>
    <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
  </rdf:Description>
