  <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/P140_assigned_attribute_to">
    <rdfs:label xml:lang="pt">atribuiu atributo para</rdfs:label>
    <rdfs:label xml:lang="de">wies Merkmal zu</rdfs:label>
    <rdfs:label xml:lang="el">απέδωσε ιδιότητα σε</rdfs:label>
    <rdfs:label xml:lang="fr">a assigné l’attribut à</rdfs:label>
    <rdfs:label xml:lang="zh">分配属性于</rdfs:label>
    <rdfs:label xml:lang="ru">получeн атрибут посрeдством</rdfs:label>
    <rdfs:label xml:lang="en">assigned attribute to</rdfs:label>
    <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity"/>
    <rdfs:comment xml:lang="en">This property associates an instance of E13 Attribute Assignment with the instance of E1 CRM Entity about which it made an attribution. The instance of E1 CRM Entity plays the role of the domain of the attribution.
