    <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity"/>
    <rdfs:label xml:lang="ru">пeрeчисляeт</rdfs:label>
    <rdfs:label xml:lang="en">lists</rdfs:label>
    <rdfs:label xml:lang="zh">列出</rdfs:label>
    <rdfs:label xml:lang="el">περιλαμβάνει</rdfs:label>
    <rdfs:label xml:lang="pt">define</rdfs:label>
    <rdfs:label xml:lang="de">listet</rdfs:label>
    <rdfs:label xml:lang="fr">énumère</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P67_refers_to"/>
    <rdfs:comment xml:lang="en">This property associates an instance of E32 Authority Document, with an instance of E1 CRM Entity which it lists for reference purposes.</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P71i_is_listed_in"/>
