    <rdfs:label xml:lang="zh">转移监护权的是</rdfs:label>
    <rdfs:label xml:lang="en">transferred custody of</rdfs:label>
    <rdfs:label xml:lang="el">μετεβίβασε κατοχή του/της/των</rdfs:label>
    <owl:inverseOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P30i_custody_transferred_through"/>
    <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E10_Transfer_of_Custody"/>
    <rdfs:comment xml:lang="en">This property identifies the instance(s) of E18 Physical Thing concerned in an instance of E10 Transfer of Custody.
The property will typically describe the object that is handed over by an instance of E39 Actor to to the custody of another instance of E39 Actor. On occasion, physical custody may be transferred involuntarily or illegally – through accident, unsolicited donation, or theft.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
