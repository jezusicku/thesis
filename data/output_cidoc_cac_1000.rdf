  <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/P73_has_translation">
    <owl:inverseOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P73i_is_translation_of"/>
    <rdfs:label xml:lang="el">έχει μετάφραση</rdfs:label>
