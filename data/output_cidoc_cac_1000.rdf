  <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/P80_end_is_qualified_by">
    <rdfs:label xml:lang="de">hat Begründung des Endes</rdfs:label>
    <rdfs:label xml:lang="ru">конeц ограничeн</rdfs:label>
