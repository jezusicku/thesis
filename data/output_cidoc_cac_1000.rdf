  <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/P41_classified">
    <rdfs:label xml:lang="pt">classificou</rdfs:label>
    <rdfs:label xml:lang="zh">分类</rdfs:label>
    <rdfs:label xml:lang="ru">классифицируeт</rdfs:label>
    <rdfs:label xml:lang="de">klassifizierte</rdfs:label>
    <rdfs:label xml:lang="en">classified</rdfs:label>
    <rdfs:label xml:lang="el">χαρακτήρισε</rdfs:label>
    <rdfs:label xml:lang="fr">a classifié</rdfs:label>
    <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E17_Type_Assignment"/>
    <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P140_assigned_attribute_to"/>
    <owl:inverseOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P41i_was_classified_by"/>
    <rdfs:comment xml:lang="en">This property records the item to which a type was assigned in an E17 Type Assignment activity.
Any instance of a CIDOC CRM entity may be assigned a type through type assignment. Type assignment events allow a more detailed path from E1 CRM Entity through P41i was classified by, E17 Type Assignment, P42 assigned, to E55 Type for assigning types to objects compared to the shortcut offered by P2 has type (is type of).</rdfs:comment>
  </rdf:Description>
