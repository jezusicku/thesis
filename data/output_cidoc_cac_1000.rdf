    <rdfs:label xml:lang="pt">é ou foi localizada em</rdfs:label>
    <rdfs:label xml:lang="zh">有之前或当前位置</rdfs:label>
    <rdfs:label xml:lang="de">hat früheren oder derzeitigen Standort</rdfs:label>
    <rdfs:label xml:lang="ru">имeeт тeкущee или бывшee мeстоположeниe</rdfs:label>
    <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
