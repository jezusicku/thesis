    <rdfs:label xml:lang="ru">Смeрть</rdfs:label>
    <rdfs:label xml:lang="pt">Morte</rdfs:label>
    <rdfs:label xml:lang="fr">Mort</rdfs:label>
    <rdfs:label xml:lang="en">Death</rdfs:label>
